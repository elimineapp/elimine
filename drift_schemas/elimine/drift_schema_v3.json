  "fixed_sql": [
    {
      "name": "substances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"substances\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "doses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"doses\" (\"id\" TEXT NOT NULL, \"substance_id\" TEXT NOT NULL REFERENCES substances (id), \"amount\" REAL NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "intakes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"intakes\" (\"id\" TEXT NOT NULL, \"substance_id\" TEXT NOT NULL REFERENCES substances (id), \"amount\" REAL NULL, \"taken_at\" INTEGER NOT NULL, \"tz_offset_min\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "intakes_taken_at",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX intakes_taken_at ON intakes (taken_at)"
        }
      ]
    },
    {
